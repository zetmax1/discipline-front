            },
            "splitFromRuleId": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "categoryId",
            "name",
            "weekdays",
            "startMin",
            "endMin",
            "validFrom",
            "validTo",
            "splitFromRuleId"
          ],
          "additionalProperties": {}
        }
      }
    },
    "required": [
      "rules"
    ],
    "additionalProperties": {}
