{
  "rule": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "number"
      },
      "categoryId": {
        "type": "number"
      },
      "name": {
        "type": "string"
      },
      "weekdays": {
        "minItems": 1,
        "maxItems": 7,
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      },
      "startMin": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1440
      },
      "endMin": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1440
      },
      "validFrom": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "validTo": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "splitFromRuleId": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "id",
      "categoryId",
      "name",
      "weekdays",
      "startMin",
      "endMin",
      "validFrom",
      "validTo",
      "splitFromRuleId"
    ],
    "additionalProperties": {}
  },
