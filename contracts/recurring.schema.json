            "startMin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "endMin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "validFrom": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "validTo": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
