            "id",
            "name",
            "category",
            "date",
            "startMin",
            "endMin",
            "startTime",
            "endTime",
            "status",
            "distractions",
            "energy",
            "actualStartMin",
            "actualEndMin",
            "focusRating",
            "note",
            "movedFromId",
            "categoryId",
            "categoryKind",
            "recurringRuleId",
            "originalDate",
            "recurringEdited"
          ],
          "additionalProperties": {}
        }
      },
      "exceptions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "ruleId": {
              "type": "number"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "reason": {
              "type": "string",
              "enum": [
                "cancelled",
