  "exception": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ruleId": {
        "type": "number"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "reason": {
        "type": "string",
        "enum": [
          "cancelled",
          "conflict",
          "moved"
        ]
      }
    },
    "required": [
      "ruleId",
      "date",
      "reason"
