# Names only — never commit values. These are build-time (Vite) variables and
# end up in the public bundle: put only public values here.
VITE_API_URL=              # e.g. https://<api-host>/api
VITE_TURNSTILE_SITE_KEY=   # Cloudflare Turnstile site key (public); required for sign-up and throttled sign-in
